<script>
(() => {
    const result = document.getElementById('pick-filters-result');
    const invoke = window.__TAURI__?.core?.invoke;
    const markdownImages = [
        {name: 'Markdown', extensions: ['md']},
        {name: 'Images', extensions: ['png', 'jpg', 'jpeg']},
    ];

    document.querySelectorAll('[data-pick-filters]').forEach((button) => {
        button.addEventListener('click', async () => {
            const variant = button.dataset.pickFilters;
            if (!invoke) {
                result.textContent = `${variant}: invoke() not available (withGlobalTauri off, or opened outside Tauri)`;
                return;
            }
            result.textContent = `${variant}: choosing…`;
            try {
                let args;
                switch (variant) {
                    case 'markdown-images':
                        args = {kind: 'file', filters: markdownImages};
                        break;
                    case 'omitted':
                        args = {kind: 'file'};
                        break;
                    case 'null':
                        args = {kind: 'file', filters: null};
                        break;
                    case 'empty':
                        args = {kind: 'file', filters: []};
                        break;
                    case 'directory':
                        args = {kind: 'directory', filters: markdownImages};
                        break;
                    case 'malformed':
                        args = {kind: 'file', filters: 'md'};
                        break;
                }
                const path = await invoke('pick_path', args);
                result.textContent = `${variant}: ${JSON.stringify(path)}`;
            } catch (error) {
                result.textContent = `${variant}: refused (${error})`;
            }
        });
    });
})();
</script>

<script>
(() => {
    const csrfTokenField = document.getElementById('save-csrf-token');
    const result = document.getElementById('save-path-result');
    const relativeResult = document.getElementById('save-path-relative-result');
    const invoke = window.__TAURI__?.core?.invoke;

    document.getElementById('save-path-button').addEventListener('click', async () => {
        if (!invoke) {
            result.textContent = 'invoke() not available (withGlobalTauri off, or opened outside Tauri)';
            return;
        }
        result.textContent = 'choosing…';
        try {
            const path = await invoke('save_path', {
                filters: [
                    {name: 'Markdown', extensions: ['md']},
                    {name: 'Text', extensions: ['txt']},
                ],
                fileName: 'notes.md',
            });
            if (path === null) {
                result.textContent = 'cancelled (null)';
                return;
            }
            result.textContent = `writing to ${path}…`;
            const body = new URLSearchParams();
            body.set('_csrf_token', csrfTokenField.value);
            body.set('path', path);
            const response = await fetch('{{ path('save_path_write') }}', {method: 'POST', body});
            const data = await response.json();
            result.textContent = response.ok
                ? `saved: ${path}`
                : `write failed (${response.status}): ${JSON.stringify(data)}`;
        } catch (error) {
            result.textContent = `refused (${error})`;
        }
    });

    document.getElementById('save-path-relative-button').addEventListener('click', async () => {
        if (!invoke) {
            relativeResult.textContent = 'invoke() not available (withGlobalTauri off, or opened outside Tauri)';
            return;
        }
        relativeResult.textContent = 'choosing…';
        try {
            const path = await invoke('save_path', {directory: 'Documents'});
            relativeResult.textContent = `unexpected success: ${JSON.stringify(path)}`;
        } catch (error) {
            relativeResult.textContent = `refused (${error})`;
        }
    });
})();
</script>

<script>
(() => {
    const fileInput = document.getElementById('durable-file');
    const uploadButton = document.getElementById('durable-upload-button');
    const csrfTokenField = document.getElementById('durable-csrf-token');
    const result = document.getElementById('durable-result');

    uploadButton.addEventListener('click', async () => {
        const file = fileInput.files[0];
        if (!file) {
            result.textContent = 'pick a file first';
            return;
        }
        result.textContent = `uploading ${file.name}…`;
        const body = new FormData();
        body.set('_csrf_token', csrfTokenField.value);
        body.set('file', file);
        const response = await fetch('{{ path('durable_upload') }}', { method: 'POST', body });
        if (!response.ok) {
            result.textContent = `upload failed (${response.status})`;
            return;
        }
        const data = await response.json();
        const downloadUrl = `/durable-upload/${encodeURIComponent(data.filename)}`;
        result.innerHTML = `stored as "${data.filename}" — <a href="${downloadUrl}">download it back</a>`;
    });
})();
</script>

<script>
(() => {
    const fileInput = document.getElementById('upload-file');
    const csrfTokenField = document.getElementById('upload-csrf-token');
    const result = document.getElementById('upload-result');

    // Fires on both click-to-select and a real OS drop onto the input —
    // that's exactly what plan 059 disabled Tauri's native drag-drop
    // handler for: without the fix, a drop never reaches this listener at
    // all (Wry swallows it before the DOM sees anything).
    fileInput.addEventListener('change', async () => {
        const file = fileInput.files[0];
        if (!file) {
            result.textContent = 'idle';
            return;
        }
        result.textContent = `uploading ${file.name}…`;
        const body = new FormData();
        body.set('_csrf_token', csrfTokenField.value);
        body.set('file', file);
        const response = await fetch('{{ path('upload') }}', { method: 'POST', body });
        if (!response.ok) {
            result.textContent = `upload failed (${response.status})`;
            return;
        }
        const data = await response.json();
        result.textContent = `received "${data.filename}" (${data.size} bytes)`;
    });
})();
</script>

<script>
(() => {
    // The close-guard probe (hub plan 055). The frontend half fetches this
    // document's context once and presents it back with every call — the
    // context is the host's, never the page's — and the backend half is pure
    // fetch() to the crude fixture route; the bridge call is PHP's, not ours.
    const invoke = window.__TAURI__?.core?.invoke;
    const result = document.getElementById('doc-guard-result');
    const csrfTokenField = document.getElementById('close-guard-csrf-token');
    const jobResult = document.getElementById('job-guard-result');
    let documentContext = null;

    document.querySelectorAll('button[data-doc-guard], button[data-doc-unguard]').forEach((button) => {
        button.addEventListener('click', async () => {
            if (!invoke) {
                result.textContent = 'invoke() not available (withGlobalTauri off, or opened outside Tauri)';
                return;
            }
            const id = button.dataset.docGuard ?? button.dataset.docUnguard;
            const registering = 'docGuard' in button.dataset;
            try {
                // One fetch per document, at first use — the contract's
                // "fetch once at startup" made lazy so the page still works
                // outside a guarded launch.
                if (documentContext === null) {
                    const answer = await invoke('close_guard_context');
                    documentContext = answer.context;
                }
                if (registering) {
                    await invoke('close_guard_register', {context: documentContext, id});
                } else {
                    await invoke('close_guard_remove', {context: documentContext, id});
                }
                result.textContent = `${id}: ${registering ? 'guarded' : 'unguarded'}`;
            } catch (error) {
                result.textContent = `${id}: refused (${error})`;
            }
        });
    });

    document.querySelectorAll('button[data-job]').forEach((button) => {
        button.addEventListener('click', async () => {
            jobResult.textContent = `${button.dataset.job} ${button.dataset.jobAction}…`;
            try {
                const body = new URLSearchParams();
                body.set('_csrf_token', csrfTokenField.value);
                const response = await fetch(
                    `/close-guard/job/${button.dataset.job}/${button.dataset.jobAction}`,
                    {method: 'POST', body},
                );
                const data = await response.json();
                jobResult.textContent = response.ok || 'fail' === button.dataset.jobAction
                    ? `${data.job}: ${data.state} (guard ${data.id})`
                    : `${button.dataset.job}: ${data.state} — ${JSON.stringify(data)}`;
            } catch (error) {
                jobResult.textContent = `${button.dataset.job}: request failed (${error})`;
            }
        });
    });
})();
</script>

<script>
(() => {
    // The open-files probe (hub plan 056). The contract's receiver sequence,
    // made clickable: the listener is awaited before the first read — so an
    // arrival racing the initial read is covered, including one that landed
    // during the splash — and after that the page reads on notification
    // only. Acceptance is idempotent by request id on the PHP side; the ack
    // is what removes the request, so holding it leaves the id pending and a
    // reload replays it — the receiver must then treat it as already
    // accepted, not process it twice.
    const invoke = window.__TAURI__?.core?.invoke;
    // The receiver subscribes on its own window, not target-less: the hub
    // emits to one window, and a plain listen() would ring for the app's
    // other windows too, making each of them read for nothing.
    const currentWindow = window.__TAURI__?.webviewWindow?.getCurrentWebviewWindow?.();
    const status = document.getElementById('open-files-status');
    const log = document.getElementById('open-files-log');
    const csrfTokenField = document.getElementById('open-files-csrf-token');
    const holdAck = document.getElementById('open-files-hold-ack');

    const append = (text) => {
        const entry = document.createElement('li');
        entry.textContent = text;
        log.append(entry);
    };

    const acceptOnce = async (request) => {
        const body = new URLSearchParams();
        body.set('_csrf_token', csrfTokenField.value);
        body.set('id', request.id);
        body.set('paths', JSON.stringify(request.paths));
        const response = await fetch('/open-files/accept', {method: 'POST', body});
        if (!response.ok) {
            throw new Error(`accept ${request.id}: HTTP ${response.status}`);
        }
        return await response.json();
    };

    let running = false, again = false;
    const drain = async () => {
        if (running) { again = true; return; }
        running = true;
        try {
            const { requests } = await invoke('open_files_pending');
            for (const request of requests) {
                const outcome = await acceptOnce(request);
                // Each path is displayed with what the PHP backend says it is
                // — file or directory (plan 057): the wire carries paths
                // only, never a type field, so the receiver asks its own
                // backend.
                const described = request.paths.map((path, index) => `${path} (${outcome.kinds[index] ?? 'unknown'})`);
                append(`request ${request.id} — ${described.join(' | ')} — ${outcome.accepted ? 'accepted (new)' : 'accepted (replay — already known, not processed again)'}`);
                if (holdAck.checked) {
                    append(`request ${request.id} — ack held, still pending`);
                } else {
                    await invoke('open_files_ack', { id: request.id });
                    append(`request ${request.id} — acknowledged`);
                }
            }
        } catch (error) {
            status.textContent = `error: ${error}`;
        } finally {
            running = false;
            if (again) { again = false; drain(); }
        }
    };

    document.getElementById('open-files-drain').addEventListener('click', () => drain());

    if (!invoke || !currentWindow) {
        status.textContent = 'invoke()/listen() not available (withGlobalTauri off, or opened outside Tauri)';
        return;
    }

    (async () => {
        // Subscribe before you read: this await is the whole race cover.
        await currentWindow.listen('tfsapp://open-files-pending', () => drain());
        status.textContent = 'listening';
        await drain();
    })();
})();
</script>

<script>
(() => {
    // The microphone probe (hub plan 050, decision 007). Three requests
    // exercise the decision table directly: audio-only should succeed
    // exactly when actions.media.microphone is declared, video-only and
    // audio+video should always refuse — WebKit grants a combined request
    // wholly or not at all, so there is no partial "audio only" fallback to
    // observe here.
    const requestResult = document.getElementById('media-request-result');
    const deviceList = document.getElementById('media-device-list');
    const recordButton = document.getElementById('media-record-button');
    const recordStatus = document.getElementById('media-record-status');
    const playback = document.getElementById('media-playback');

    const stopStream = (stream) => stream.getTracks().forEach((track) => track.stop());

    document.querySelectorAll('[data-media-request]').forEach((button) => {
        button.addEventListener('click', async () => {
            const kind = button.dataset.mediaRequest;
            const constraints = {
                audio: kind === 'audio' || kind === 'audio-video',
                video: kind === 'video' || kind === 'audio-video',
            };
            requestResult.textContent = `${kind}: requesting…`;
            try {
                const stream = await navigator.mediaDevices.getUserMedia(constraints);
                requestResult.textContent = `${kind}: granted (${stream.getTracks().map((t) => t.kind).join(', ')})`;
                stopStream(stream);
            } catch (error) {
                requestResult.textContent = `${kind}: refused (${error.name}: ${error.message})`;
            }
        });
    });

    document.getElementById('media-list-devices').addEventListener('click', async () => {
        deviceList.textContent = '';
        try {
            // A device-info grant is what makes the labels below non-empty —
            // without it enumerateDevices() still lists the devices, but
            // every label is blank (CONTRACT.md §7).
            const devices = await navigator.mediaDevices.enumerateDevices();
            for (const device of devices.filter((d) => d.kind === 'audioinput')) {
                const item = document.createElement('li');
                item.textContent = `${device.label || '(no label — device-info not granted)'} — ${device.deviceId}`;
                deviceList.append(item);
            }
        } catch (error) {
            const item = document.createElement('li');
            item.textContent = `error: ${error}`;
            deviceList.append(item);
        }
    });

    // Records raw PCM through Web Audio's ScriptProcessorNode and encodes it
    // to a WAV blob by hand, rather than MediaRecorder: WebKitGTK 2.52.6
    // throws "NotSupportedError: The MediaRecorder is unsupported on this
    // platform" — the grant itself works (the audio-only request above
    // succeeds), this is a gap in this WebKit port's own API surface.
    // ScriptProcessorNode is deprecated by spec but has been in WebKitGTK
    // for years, which is exactly the property this probe needs.
    function encodeWav(samples, sampleRate) {
        const buffer = new ArrayBuffer(44 + samples.length * 2);
        const view = new DataView(buffer);
        const writeString = (offset, text) => {
            for (let i = 0; i < text.length; i++) {
                view.setUint8(offset + i, text.charCodeAt(i));
            }
        };
        writeString(0, 'RIFF');
        view.setUint32(4, 36 + samples.length * 2, true);
        writeString(8, 'WAVE');
        writeString(12, 'fmt ');
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true); // PCM
        view.setUint16(22, 1, true); // mono
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate * 2, true); // byte rate (mono, 16-bit)
        view.setUint16(32, 2, true); // block align
        view.setUint16(34, 16, true); // bits per sample
        writeString(36, 'data');
        view.setUint32(40, samples.length * 2, true);
        let offset = 44;
        for (let i = 0; i < samples.length; i++, offset += 2) {
            const clamped = Math.max(-1, Math.min(1, samples[i]));
            view.setInt16(offset, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);
        }
        return new Blob([view], {type: 'audio/wav'});
    }

    recordButton.addEventListener('click', async () => {
        recordButton.disabled = true;
        recordStatus.textContent = 'requesting microphone…';
        let audioContext;
        try {
            const stream = await navigator.mediaDevices.getUserMedia({audio: true});
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const source = audioContext.createMediaStreamSource(stream);
            const processor = audioContext.createScriptProcessor(4096, 1, 1);
            // A silent sink: WebKitGTK's ScriptProcessorNode only fires
            // onaudioprocess once the graph reaches a destination, and a
            // zero-gain node keeps the mic from feeding back into the
            // speakers while recording.
            const silence = audioContext.createGain();
            silence.gain.value = 0;
            const chunks = [];
            let sampleCount = 0;
            processor.onaudioprocess = (event) => {
                chunks.push(new Float32Array(event.inputBuffer.getChannelData(0)));
                sampleCount += event.inputBuffer.length;
            };
            source.connect(processor);
            processor.connect(silence);
            silence.connect(audioContext.destination);
            recordStatus.textContent = 'recording for 5 seconds — say something…';
            await new Promise((resolve) => setTimeout(resolve, 5000));
            processor.disconnect();
            source.disconnect();
            stopStream(stream);
            const pcm = new Float32Array(sampleCount);
            let offset = 0;
            for (const chunk of chunks) {
                pcm.set(chunk, offset);
                offset += chunk.length;
            }
            const wavBlob = encodeWav(pcm, audioContext.sampleRate);
            playback.src = URL.createObjectURL(wavBlob);
            recordStatus.textContent = `recorded ${wavBlob.size} bytes — press play above`;
        } catch (error) {
            recordStatus.textContent = `refused (${error.name}: ${error.message})`;
        } finally {
            if (audioContext) {
                await audioContext.close();
            }
            recordButton.disabled = false;
        }
    });
})();
</script>

