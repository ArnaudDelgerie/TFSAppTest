{% extends 'base.html.twig' %}

{% block title %}Hello TFSAppController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Born to be a TFSApp</h1>
    <p><a href="{{ path('account') }}">Account</a></p>

    <p>Async worker mode: <strong id="async-worker-mode">{{ async_worker_mode ? 'ON — Messenger worker consumes "async" in the background' : 'OFF — sync:// runs the handler inline on dispatch' }}</strong></p>

    <p>
        <button type="button" id="ping-button">Trigger background job</button>
        <span id="ping-status">idle</span>
    </p>
    <input type="hidden" id="ping-csrf-token" value="{{ csrf_token('ping') }}">
</div>

<div class="example-wrapper">
    <h2>Secrets demo (native actions, plan 029)</h2>
    <p>
        <label>Key <input type="text" id="secrets-key" value="openai"></label>
        <label>Value <input type="text" id="secrets-value" value="sk-test"></label>
    </p>
    <input type="hidden" id="secrets-csrf-token" value="{{ csrf_token('secrets_bridge') }}">
    <p>
        Bridge (PHP -&gt; HTTP -&gt; keyring):
        <button type="button" data-bridge="set">set</button>
        <button type="button" data-bridge="has">has</button>
        <button type="button" data-bridge="get">get</button>
        <button type="button" data-bridge="delete">delete</button>
        <span id="bridge-result">idle</span>
    </p>
    <p>
        IPC (WebView -&gt; Tauri invoke() -&gt; keyring):
        <button type="button" data-ipc="set">set</button>
        <button type="button" data-ipc="has">has</button>
        <button type="button" data-ipc="get">get</button>
        <button type="button" data-ipc="delete">delete</button>
        <span id="ipc-result">idle</span>
    </p>
</div>

<div class="example-wrapper">
    <h2>Check for updates (native actions, plan 035)</h2>
    <p>
        Bridge (PHP -&gt; HTTP -&gt; GitHub):
        <button type="button" id="update-bridge-button">check</button>
    </p>
    <div id="update-bridge-result">idle</div>
    <p>
        IPC (WebView -&gt; Tauri invoke() -&gt; GitHub):
        <button type="button" id="update-ipc-button">check</button>
    </p>
    <div id="update-ipc-result">idle</div>
</div>

<div class="example-wrapper">
    <h2>File upload demo (native drag-and-drop, station plan 059)</h2>
    <p>Drag a file from the file manager onto the field below, or click it to pick one.</p>
    <p>
        <label>File <input type="file" id="upload-file"></label>
    </p>
    <input type="hidden" id="upload-csrf-token" value="{{ csrf_token('upload') }}">
    <div id="upload-result">idle</div>
</div>

<div class="example-wrapper">
    <h2>Durable file (hub plan 049)</h2>
    <p>Written under APP_UPLOAD_DIR — should survive an update, a rollback, and an export/import round trip.</p>
    <p>
        <label>File <input type="file" id="durable-file"></label>
        <button type="button" id="durable-upload-button">Upload</button>
    </p>
    <input type="hidden" id="durable-csrf-token" value="{{ csrf_token('durable_upload') }}">
    <div id="durable-result">idle</div>
</div>

<div class="example-wrapper">
    <h2>Native path picker &amp; save dialog (hub plans 038, 051, 053)</h2>
    <p>This IPC-only probe returns a selected absolute path; it does not upload or read it.</p>
    <p>
        <button type="button" data-picker="file">Pick file</button>
        <button type="button" data-picker="directory">Pick directory</button>
        <span id="picker-result">idle</span>
    </p>
    <p>The hub never writes: a chosen save path is posted to a crude fixture route that writes a fixed string with <code>file_put_contents</code>.</p>
    <input type="hidden" id="save-csrf-token" value="{{ csrf_token('save_path_write') }}">
    <p>
        <button type="button" id="save-path-button">Save As… (Markdown/Text, notes.md)</button>
        <span id="save-path-result">idle</span>
    </p>
    <p>
        <button type="button" id="save-path-relative-button">Save As with a relative directory (should refuse)</button>
        <span id="save-path-relative-result">idle</span>
    </p>
    <p>Hub plan 053 — optional file filters on pick_path, same shape as save_path:</p>
    <p>
        <button type="button" data-pick-filters="markdown-images">Pick file (Markdown/Images filters)</button>
        <button type="button" data-pick-filters="omitted">Pick file (no filters key)</button>
        <button type="button" data-pick-filters="null">Pick file (null filters)</button>
        <button type="button" data-pick-filters="empty">Pick file (empty filters)</button>
        <button type="button" data-pick-filters="directory">Pick directory (filters should be ignored)</button>
        <button type="button" data-pick-filters="malformed">Pick file (wrongly typed filter, should refuse)</button>
        <span id="pick-filters-result">idle</span>
    </p>
</div>

<div>
    <h2>Close guards (hub plan 055)</h2>
    <p>Frontend guards, two independent documents — invoke() with this document's context:</p>
    <p>
        <button type="button" data-doc-guard="editor:doc-1">Mark doc-1 dirty</button>
        <button type="button" data-doc-unguard="editor:doc-1">Mark doc-1 clean</button>
        <button type="button" data-doc-guard="editor:doc-2">Mark doc-2 dirty</button>
        <button type="button" data-doc-unguard="editor:doc-2">Mark doc-2 clean</button>
        <span id="doc-guard-result">idle</span>
    </p>
    <p>Backend guards, two independent simulated jobs — registered and removed by PHP through the loopback bridge:</p>
    <input type="hidden" id="close-guard-csrf-token" value="{{ csrf_token('close_guard_job') }}">
    <p>
        <button type="button" data-job="export" data-job-action="start">Start export job</button>
        <button type="button" data-job="export" data-job-action="complete">Complete export job</button>
        <button type="button" data-job="export" data-job-action="fail">Fail export job</button>
        <button type="button" data-job="mail" data-job-action="start">Start mail job</button>
        <button type="button" data-job="mail" data-job-action="complete">Complete mail job</button>
        <button type="button" data-job="mail" data-job-action="fail">Fail mail job</button>
        <span id="job-guard-result">idle</span>
    </p>
</div>

<div>
    <h2>Open with local files (hub plan 056)</h2>
    <p>Receiver — subscribes to <code>tfsapp://open-files-pending</code> before its first read, then reads on notification only, never polls:</p>
    <input type="hidden" id="open-files-csrf-token" value="{{ csrf_token('open_files_probe') }}">
    <p>
        <label><input type="checkbox" id="open-files-hold-ack"> Hold acknowledgements (leaves requests pending, to exercise reload replay)</label>
        <button type="button" id="open-files-drain">Read pending now</button>
        <span id="open-files-status">starting…</span>
    </p>
    <ul id="open-files-log"></ul>
</div>

<div class="example-wrapper">
    <h2>Microphone capture (hub plan 050, <code>actions.media</code>)</h2>
    <p>TFS_MEDIA_MICROPHONE: <strong id="media-microphone-flag">{{ media_microphone ? 'granted' : 'not granted' }}</strong></p>
    <p>
        <button type="button" data-media-request="audio">Request audio-only</button>
        <button type="button" data-media-request="video">Request video-only (should refuse)</button>
        <button type="button" data-media-request="audio-video">Request audio+video (should refuse)</button>
        <span id="media-request-result">idle</span>
    </p>
    <p>
        <button type="button" id="media-list-devices">List input devices (enumerateDevices)</button>
    </p>
    <ul id="media-device-list"></ul>
    <p>
        <button type="button" id="media-record-button">Record 5 seconds</button>
        <span id="media-record-status">idle</span>
    </p>
    <p><audio id="media-playback" controls></audio></p>
</div>

<script>
(() => {
    const button = document.getElementById('ping-button');
    const status = document.getElementById('ping-status');
    const csrfTokenField = document.getElementById('ping-csrf-token');
    const mercurePublicUrl = {{ mercure_public_url|json_encode|raw }};
    const topic = {{ ping_topic|json_encode|raw }};
    let expectedCorrelationId = null;
    // Sync-mode dispatch publishes the Mercure update *before* /ping's own
    // JSON response comes back (station plan 033 step 2 finding), so the
    // push can land before the click handler below even knows which
    // correlationId to expect. Buffer every push by id so a push that
    // arrives first is still found once the id becomes known, instead of
    // the click handler's own status write clobbering it.
    const receivedByCorrelationId = new Map();

    if (mercurePublicUrl) {
        const url = new URL(mercurePublicUrl);
        url.searchParams.append('topic', topic);
        // withCredentials is required for the mercureAuthorization cookie to
        // be sent, even same-origin — it defaults to false per spec.
        const source = new EventSource(url, {withCredentials: true});
        source.onmessage = (event) => {
            const data = JSON.parse(event.data);
            receivedByCorrelationId.set(data.correlationId, data);
            if (data.correlationId === expectedCorrelationId) {
                status.textContent = `done: "${data.text}" (completed ${data.completedAt})`;
            }
        };
    }

    button.addEventListener('click', async () => {
        status.textContent = 'dispatching…';
        const body = new URLSearchParams();
        body.set('_csrf_token', csrfTokenField.value);
        const response = await fetch('{{ path('ping') }}', { method: 'POST', body });
        if (!response.ok) {
            status.textContent = 'dispatch failed';
            return;
        }
        const data = await response.json();
        expectedCorrelationId = data.correlationId;
        const already = receivedByCorrelationId.get(expectedCorrelationId);
        if (already) {
            status.textContent = `done: "${already.text}" (completed ${already.completedAt})`;
        } else {
            status.textContent = `dispatched (correlation ${data.correlationId}), waiting for completion…`;
        }
    });
})();
</script>

<script>
(() => {
    const keyEl = document.getElementById('secrets-key');
    const valueEl = document.getElementById('secrets-value');
    const csrfTokenField = document.getElementById('secrets-csrf-token');
    const bridgeResult = document.getElementById('bridge-result');
    const ipcResult = document.getElementById('ipc-result');
    const invoke = window.__TAURI__?.core?.invoke;

    document.querySelectorAll('[data-bridge]').forEach((button) => {
        button.addEventListener('click', async () => {
            const action = button.dataset.bridge;
            const body = new URLSearchParams();
            body.set('_csrf_token', csrfTokenField.value);
            body.set('key', keyEl.value);
            if (action === 'set') {
                body.set('value', valueEl.value);
            }
            const response = await fetch(`/secrets/bridge/${action}`, { method: 'POST', body });
            bridgeResult.textContent = `${action}: ${response.status} ${JSON.stringify(await response.json())}`;
        });
    });

    document.querySelectorAll('[data-ipc]').forEach((button) => {
        button.addEventListener('click', async () => {
            const action = button.dataset.ipc;
            if (!invoke) {
                ipcResult.textContent = `${action}: invoke() not available (withGlobalTauri off, or opened outside Tauri)`;
                return;
            }
            try {
                const args = action === 'set' ? { key: keyEl.value, value: valueEl.value } : { key: keyEl.value };
                const data = await invoke(`secret_${action}`, args);
                ipcResult.textContent = `${action}: ok ${JSON.stringify(data)}`;
            } catch (error) {
                ipcResult.textContent = `${action}: refused (${error})`;
            }
        });
    });
})();
</script>

<script>
(() => {
    const bridgeButton = document.getElementById('update-bridge-button');
    const ipcButton = document.getElementById('update-ipc-button');
    const bridgeResult = document.getElementById('update-bridge-result');
    const ipcResult = document.getElementById('update-ipc-result');
    const invoke = window.__TAURI__?.core?.invoke;

    // Shared by both transports: CONTRACT.md's result shape is identical
    // whichever one answered, so there is exactly one renderer, not two.
    function renderUpdateResult(el, data) {
        if (data.status === 'unavailable') {
            el.textContent = `unavailable (${data.reason})`;
            return;
        }
        const headline = data.update_available
            ? `update available: ${data.current} -> ${data.latest}`
            : `up to date (running ${data.current}, latest published ${data.latest})`;
        el.innerHTML = `<p>${headline}</p>`
            + `<p><a href="${data.release_url}" target="_blank" rel="noopener">${data.release_url}</a></p>`
            + `<p>asset: ${data.asset.name} (${data.asset.size} bytes)</p>`
            + `<pre>${data.notes}</pre>`;
    }

    bridgeButton.addEventListener('click', async () => {
        bridgeResult.textContent = 'checking…';
        const response = await fetch('/update/bridge');
        const data = await response.json();
        if (data.available === false) {
            bridgeResult.textContent = 'bridge not available (actions.update.bridge is off)';
            return;
        }
        renderUpdateResult(bridgeResult, data);
    });

    ipcButton.addEventListener('click', async () => {
        if (!invoke) {
            ipcResult.textContent = 'invoke() not available (withGlobalTauri off, or opened outside Tauri)';
            return;
        }
        ipcResult.textContent = 'checking…';
        try {
            const data = await invoke('update_check');
            renderUpdateResult(ipcResult, data);
        } catch (error) {
            ipcResult.textContent = `refused (${error})`;
        }
    });
})();
</script>

